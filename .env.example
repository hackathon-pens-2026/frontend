# Konfigurasi backend untuk BFF same-origin /api/v1 (server-side, tanpa /api/v1).
# Salin file ini menjadi .env.local lalu sesuaikan nilainya.
#
# Lokal (dotnet run --launch-profile http) : http://localhost:5217
# Docker Compose (lihat infrastructure)    : http://backend:8080
# Deployment (Vercel menuju Azure)         : URL HTTPS backend
BACKEND_URL=http://localhost:5217

# Fallback lama yang masih dibaca kode (opsional, jangan diisi bila BACKEND_URL tersedia).
# NEXT_PUBLIC_API_URL=http://localhost:8080
